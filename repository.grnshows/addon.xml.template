<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.grnshows" name="GRN Shows Repository" version="1.1.0" provider-name="GRN Shows Contributors">
  <extension point="xbmc.addon.repository" name="GRN Shows Repository">
    <dir>
      <info compressed="false">{{BASE_URL}}/addons.xml</info>
      <checksum>{{BASE_URL}}/addons.xml.md5</checksum>
      <datadir zip="true">{{BASE_URL}}/zips</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">GRN Shows add-on repository</summary>
    <description lang="en_GB">Updates for the GRN Shows video add-on.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets><icon>icon.png</icon><fanart>fanart.jpg</fanart></assets>
  </extension>
</addon>
